{
  "name": "shotparty",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "start": "npm run dev --workspace web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c web/playwright.config.ts",
    "screenshots": "playwright test -c web/playwright.screenshots.config.ts",
    "coverage:badge": "tsx scripts/coverage-badge.ts",
    "diagrams": "bash scripts/render-diagrams.sh",
    "lint:infra": "cfn-lint infra/*/template.yaml && bash -n scripts/*.sh",
    "lint:shell": "shellcheck -x scripts/*.sh",
    "lint:identifiers": "bash scripts/check-no-identifiers.sh",
    "lint:docs": "tsx scripts/check-doc-links.ts",
    "build": "npm run build --workspaces --if-present",
    "event:create": "tsx scripts/create-event.ts",
    "qr": "tsx scripts/make-qr.ts",
    "session:mint": "tsx scripts/mint-session.ts",
    "gallery": "tsx scripts/gallery.ts",
    "load-test": "tsx scripts/load-test.ts",
    "download": "tsx scripts/download-all.ts",
    "event:close": "tsx scripts/close-event.ts",
    "event:update": "tsx scripts/update-event.ts",
    "mock-api": "tsx scripts/mock-api.ts",
    "setup": "tsx scripts/setup.ts",
    "teardown": "bash scripts/teardown.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1156.0",
    "@aws-sdk/client-cloudfront": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.1"
  }
}
